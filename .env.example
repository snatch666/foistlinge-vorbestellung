# PayPal Developer App (developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox = Testzahlungen, live = echtes Geld
PAYPAL_ENV=sandbox

# Postgres-Datenbank (z.B. von neon.tech). Leer lassen = lokale Datei als Fallback.
DATABASE_URL=

# Login fuer den Admin-Bereich (/admin)
ADMIN_USER=admin
ADMIN_PASS=bitte-aendern

# Produktdaten
ALBUM_PRICE=18.00
ALBUM_SHIPPING=6.00
ALBUM_CURRENCY=EUR

PORT=3000
